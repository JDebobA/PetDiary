<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PetDiary" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="colorPrimary">@color/coffee_brown</item>
        <item name="colorPrimaryVariant">@color/coffee_brown_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/latte</item>
        <item name="colorSecondaryVariant">@color/latte_dark</item>
        <item name="colorOnSecondary">@color/dark_text</item>

        <item name="android:colorBackground">@color/white_bg</item>
        <item name="colorSurface">@color/white_bg</item>
        <item name="colorOnSurface">@color/dark_text</item>

        <item name="android:statusBarColor">@color/coffee_brown</item>
        <item name="android:navigationBarColor">@color/white_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:textColorSecondary">@color/dark_text</item>
        <item name="android:textColorHint">@color/latte</item>

        <item name="android:windowBackground">@color/white_bg</item>
        <item name="android:divider">@color/cream</item>

        <item name="floatingActionButtonStyle">@style/Widget.PetDiary.Fab</item>
    </style>

    <style name="Widget.PetDiary.Fab" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/coffee_brown</item>
        <item name="tint">@color/white</item>
        <item name="rippleColor">@color/latte</item>
    </style>

    <style name="Widget.PetDiary.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/coffee_brown</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.PetDiary.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/cream</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>

</resources>